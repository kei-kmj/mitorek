{
  "name": "mitorek",
  "type": "module",
  "packageManager": "npm@11.19.0",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply mitorek --local",
    "db:migrate:remote": "wrangler d1 migrations apply mitorek --remote"
  },
  "dependencies": {
    "@scalar/hono-api-reference": "^0.12.2",
    "arktype": "^2.2.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.8",
    "hono-openapi": "^1.3.3",
    "ulidx": "^2.4.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "~4.1.11",
    "wrangler": "^4.110.0"
  }
}
