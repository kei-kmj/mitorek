{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; npx biome check --write --no-errors-on-unmatched \"$f\"; } 2>/dev/null || true",
						"statusMessage": "Biome で整形中",
						"timeout": 60,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			}
		]
	},
	"permissions": {
		"allow": [
			"Bash(git status:*)",
			"Bash(git log:*)",
			"Bash(git diff:*)",
			"Bash(git show:*)",
			"Bash(git ls-files:*)",
			"Bash(git check-ignore:*)",
			"Bash(npm run lint)",
			"Bash(npm run lint:ci)",
			"Bash(npx biome check:*)",
			"Bash(npx vitest --run:*)",
			"Bash(npm test:*)",
			"Bash(npx wrangler d1 execute mitorek --local --command \"SELECT:*)"
		]
	}
}
