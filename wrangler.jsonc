{
	"$schema": "node_modules/wrangler/config-schema.json",
	// 画面用の CSS / JS。/static/* はワーカーを通さず配信される
	"assets": { "directory": "./public" },
	"compatibility_date": "2026-08-22",
	"d1_databases": [
		{
			"binding": "mitorek_db",
			"database_id": "db173b9f-a793-4da8-8b91-d32d41d6ed3d",
			"database_name": "mitorek"
		}
	],
	"main": "src/index.ts",
	"name": "mitorek",
	"r2_buckets": [
		{
			"binding": "mitorek_images",
			"bucket_name": "mitorek-images"
		}
	],
	// 認証 (better-auth) が入るまでの固定利用者。ローカル D1 の users に同じ id の行がある。認証導入時に消す
	"vars": { "DEV_USER_ID": "01M31AGK3ABN7NF1P12QJVYGQ0" }
	// "compatibility_flags": [
