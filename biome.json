{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"assist": {
		"actions": { "source": { "preset": "all" } },
		"enabled": true
	},
	"files": {
		"ignoreUnknown": false,
		"includes": ["**", "!migrations", "!package.json", "!package-lock.json"]
	},
	"formatter": { "enabled": true, "indentStyle": "tab" },
	"javascript": { "formatter": { "quoteStyle": "double" } },
	"linter": {
		"domains": {
			"astro": "none",
			"drizzle": "all",
			"next": "none",
			"playwright": "none",
			"project": "all",
			"qwik": "none",
			"react": "none",
			"reactNative": "none",
			"solid": "none",
			"svelte": "none",
			"tailwind": "none",
			"test": "all",
			"turborepo": "none",
			"types": "all",
			"vue": "none"
		},
		"enabled": true,
		"rules": {
			"nursery": { "preset": "all" },
			"preset": "all"
		}
	},
	"overrides": [
		{
			"includes": ["src/index.ts", "*.config.*", "vitest.config.mts"],
			"linter": { "rules": { "style": { "noDefaultExport": "off" } } }
		},
		{
			"includes": ["test/**"],
			"linter": { "rules": { "style": { "noMagicNumbers": "off" } } }
		},
		{
			"assist": { "actions": { "source": { "useSortedKeys": "off" } } },
			"includes": ["src/db/schema/**"],
			"linter": {
				"rules": { "suspicious": { "noDeprecatedImports": "off" } }
			}
		}
	],
	"vcs": { "clientKind": "git", "enabled": true, "useIgnoreFile": true }
}
